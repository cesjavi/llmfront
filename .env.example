# ─── Modo de operación ────────────────────────────────────────────────────────
# "api"   → Solo cloud (HF Inference API + Groq). Sin torch. ~100 MB RAM.
# "local" → Habilita descarga y ejecución local de modelos. RAM alta.
LLMFRONT_MODE=api

# ─── Búsqueda IA con Groq ─────────────────────────────────────────────────────
# Habilita/deshabilita el botón "Búsqueda IA" en el explorador de modelos.
# Requiere GROQ_API_KEY válida para funcionar.
GROQ_AI_SEARCH_ENABLED=true

# ─── HuggingFace Token ────────────────────────────────────────────────────────
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# ─── Groq API Key ─────────────────────────────────────────────────────────────
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
